+# =============================================================================
+# SUPPORT & RESISTANCE — swing pivots, clustered into price zones
+# =============================================================================
+
+def find_support_resistance(df: pd.DataFrame, pivot_window: int = 3,
+                            max_levels: int = 6) -> Dict[str, Any]:
+    """Find horizontal S/R levels from confirmed local swing highs/lows.
+
+    Nearby pivots are clustered using an ATR-scaled tolerance. Levels are
+    estimates from the visible candle window, not guaranteed turning points.
+    """
+    empty = {
+        "supports": [], "resistances": [], "support": None, "resistance": None,
+        "status": "Data support/resistance tidak cukup", "zone_width": 0.0,
+        "pivot_levels": [],
+    }
+    required = {"high", "low", "close"}
+    if df is None or len(df) < max(2 * pivot_window + 3, 10) or not required.issubset(df.columns):
+        return empty
+
+    window = max(2, int(pivot_window))
+    highs = pd.to_numeric(df["high"], errors="coerce").to_numpy(dtype=float)
+    lows = pd.to_numeric(df["low"], errors="coerce").to_numpy(dtype=float)
+    close = pd.to_numeric(df["close"], errors="coerce").to_numpy(dtype=float)
+    valid = np.isfinite(highs) & np.isfinite(lows) & np.isfinite(close)
+    if valid.sum() < max(2 * window + 3, 10):
+        return empty
+
+    atr = float(df["atr_14"].iloc[-1]) if "atr_14" in df.columns and pd.notna(df["atr_14"].iloc[-1]) else 0.0
+    price = float(close[-1])
+    if not np.isfinite(price) or price <= 0:
+        return empty
+    tolerance = max(atr * 0.35, price * 0.001)
+    zone_width = max(atr * 0.25, price * 0.0005)
+
+    pivots: List[Tuple[float, str]] = []
+    for i in range(window, len(df) - window):
+        if not valid[i] or not valid[i-window:i+window+1].all():
+            continue
+        local_highs = highs[i-window:i+window+1]
+        local_lows = lows[i-window:i+window+1]
+        if highs[i] == np.max(local_highs) and np.count_nonzero(local_highs == highs[i]) == 1:
+            pivots.append((float(highs[i]), "R"))
+        if lows[i] == np.min(local_lows) and np.count_nonzero(local_lows == lows[i]) == 1:
+            pivots.append((float(lows[i]), "S"))
+
+    if not pivots:
+        return {**empty, "zone_width": zone_width}
+
+    # Merge nearby pivot prices, preserving the pivot type with the most touches.
+    clusters: List[Dict[str, Any]] = []
+    for level, kind in sorted(pivots, key=lambda item: item[0]):
+        if clusters and level - clusters[-1]["high"] <= tolerance:
+            cluster = clusters[-1]
+            cluster["prices"].append(level)
+            cluster["high"] = level
+            cluster["types"][kind] = cluster["types"].get(kind, 0) + 1
+        else:
+            clusters.append({"prices": [level], "high": level, "types": {kind: 1}})
+
+    levels = []
+    for cluster in clusters:
+        level = float(np.mean(cluster["prices"]))
+        kind = max(cluster["types"], key=cluster["types"].get)
+        levels.append({"price": level, "kind": kind, "touches": len(cluster["prices"])})
+
+    supports = sorted((x for x in levels if x["price"] < price), key=lambda x: price - x["price"])
+    resistances = sorted((x for x in levels if x["price"] > price), key=lambda x: x["price"] - price)
+    prev_close = float(close[-2]) if len(close) > 1 and np.isfinite(close[-2]) else price
+    last_high, last_low = float(highs[-1]), float(lows[-1])
+
+    # Determine breakout/retest against the nearest historical pivot, even if
+    # price has just crossed it and it is no longer on the opposite side.
+    nearest = min(levels, key=lambda x: abs(price - x["price"]))
+    level = nearest["price"]
+    if prev_close <= level + tolerance and price > level + tolerance:
+        status = "Breakout bullish"
+    elif prev_close >= level - tolerance and price < level - tolerance:
+        status = "Breakdown bearish"
+    elif prev_close > level and last_low <= level + tolerance and price >= level:
+        status = "Retest support"
+    elif prev_close < level and last_high >= level - tolerance and price <= level:
+        status = "Retest resistance"
+    elif supports and abs(price - supports[0]["price"]) <= tolerance:
+        status = "Dekat support"
+    elif resistances and abs(price - resistances[0]["price"]) <= tolerance:
+        status = "Dekat resistance"
+    else:
+        status = "Di antara support/resistance"
+
+    return {
+        "supports": supports[:max_levels],
+        "resistances": resistances[:max_levels],
+        "support": supports[0]["price"] if supports else None,
+        "resistance": resistances[0]["price"] if resistances else None,
+        "status": status,
+        "zone_width": zone_width,
+        "pivot_levels": levels,
+    }
+
+
