+# =============================================================================
+# SUPPORT & RESISTANCE — ATR-scaled swing-pivot zones
+# =============================================================================
+
+def find_support_resistance(df: pd.DataFrame, pivot_window: int = 3,
+                            max_levels: int = 6) -> Dict[str, Any]:
+    """Estimate S/R from confirmed local pivots, clustered separately by side.
+
+    Pivots need candles on both sides, so the latest ``pivot_window`` candles
+    cannot create a pivot. Nearby pivots of the same type form one zone; touch
+    counts are retained as a simple measure of historical relevance.
+    """
+    empty = {
+        "supports": [], "resistances": [], "support": None, "resistance": None,
+        "status": "Data support/resistance tidak cukup", "zone_width": 0.0,
+        "event_level": None,
+    }
+    window = max(2, int(pivot_window))
+    required = {"high", "low", "close"}
+    if df is None or not required.issubset(df.columns) or len(df) < 2 * window + 3:
+        return empty
+
+    highs = pd.to_numeric(df["high"], errors="coerce").to_numpy(dtype=float)
+    lows = pd.to_numeric(df["low"], errors="coerce").to_numpy(dtype=float)
+    closes = pd.to_numeric(df["close"], errors="coerce").to_numpy(dtype=float)
+    price = float(closes[-1])
+    if not np.isfinite(price) or price <= 0:
+        return empty
+
+    atr = 0.0
+    if "atr_14" in df.columns and pd.notna(df["atr_14"].iloc[-1]):
+        atr = float(df["atr_14"].iloc[-1])
+    if not np.isfinite(atr) or atr < 0:
+        atr = 0.0
+    tolerance = max(atr * 0.35, price * 0.001)
+    zone_width = max(atr * 0.25, price * 0.0005)
+
+    pivot_highs: List[float] = []
+    pivot_lows: List[float] = []
+    for i in range(window, len(df) - window):
+        h_slice = highs[i - window:i + window + 1]
+        l_slice = lows[i - window:i + window + 1]
+        if not np.isfinite(h_slice).all() or not np.isfinite(l_slice).all():
+            continue
+        if highs[i] == np.max(h_slice) and np.count_nonzero(h_slice == highs[i]) == 1:
+            pivot_highs.append(float(highs[i]))
+        if lows[i] == np.min(l_slice) and np.count_nonzero(l_slice == lows[i]) == 1:
+            pivot_lows.append(float(lows[i]))
+
+    def _cluster(values: List[float], kind: str) -> List[Dict[str, Any]]:
+        clusters: List[List[float]] = []
+        for value in sorted(values):
+            # Compare to the current cluster mean to prevent chaining many
+            # individually-near pivots into an excessively broad level.
+            if clusters and abs(value - float(np.mean(clusters[-1]))) <= tolerance:
+                clusters[-1].append(value)
+            else:
+                clusters.append([value])
+        levels = [
+            {"price": float(np.mean(group)), "kind": kind, "touches": len(group),
+             "zone_low": float(np.mean(group)) - zone_width,
+             "zone_high": float(np.mean(group)) + zone_width}
+            for group in clusters
+        ]
+        return levels
+
+    supports = [x for x in _cluster(pivot_lows, "S") if x["price"] <= price + tolerance]
+    resistances = [x for x in _cluster(pivot_highs, "R") if x["price"] >= price - tolerance]
+    supports.sort(key=lambda x: (abs(price - x["price"]), -x["touches"]))
+    resistances.sort(key=lambda x: (abs(price - x["price"]), -x["touches"]))
+    nearest_support = supports[0] if supports else None
+    nearest_resistance = resistances[0] if resistances else None
+
+    previous_close = float(closes[-2]) if len(closes) > 1 and np.isfinite(closes[-2]) else price
+    last_high, last_low = float(highs[-1]), float(lows[-1])
+    event_level = None
+    status = "Di antara support/resistance"
+
+    # Confirm a break only when the close crosses a pivot by a volatility-scaled
+    # margin. Retests require a wick into the zone and a close back on its side.
+    crossed_up = [x for x in _cluster(pivot_highs, "R")
+                  if previous_close <= x["price"] + tolerance and price > x["price"] + tolerance]
+    crossed_down = [x for x in _cluster(pivot_lows, "S")
+                    if previous_close >= x["price"] - tolerance and price < x["price"] - tolerance]
+    if crossed_up:
+        event_level = min(crossed_up, key=lambda x: abs(price - x["price"]))["price"]
+        status = "Breakout bullish"
+    elif crossed_down:
+        event_level = min(crossed_down, key=lambda x: abs(price - x["price"]))["price"]
+        status = "Breakdown bearish"
+    elif nearest_support and last_low <= nearest_support["zone_high"] and price > nearest_support["price"]:
+        event_level = nearest_support["price"]
+        status = "Retest support" if previous_close > nearest_support["price"] else "Dekat support"
+    elif nearest_resistance and last_high >= nearest_resistance["zone_low"] and price < nearest_resistance["price"]:
+        event_level = nearest_resistance["price"]
+        status = "Retest resistance" if previous_close < nearest_resistance["price"] else "Dekat resistance"
+    elif nearest_support and abs(price - nearest_support["price"]) <= tolerance:
+        status = "Dekat support"
+    elif nearest_resistance and abs(price - nearest_resistance["price"]) <= tolerance:
+        status = "Dekat resistance"
+
+    return {
+        "supports": supports[:max_levels],
+        "resistances": resistances[:max_levels],
+        "support": nearest_support["price"] if nearest_support else None,
+        "resistance": nearest_resistance["price"] if nearest_resistance else None,
+        "status": status,
+        "zone_width": zone_width,
+        "event_level": event_level,
+    }
+
